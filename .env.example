# Copie este arquivo para ".env" (sem o .example) e preencha os dois primeiros valores.

# Seu nome de usuário no Letterboxd: a parte depois de letterboxd.com/
LETTERBOXD_USER="Insira_Usuario_letterboxd"

# Sua chave da API do TMDB (https://www.themoviedb.org/settings/api).
# Pode ser a "Chave da API" (32 caracteres) ou o "Token de Leitura da API" (começa com eyJ).
TMDB_API_KEY="Insira_Chave_TMDB"

# ---- Opcionais (os valores abaixo já são os padrões) ----
# Idioma dos títulos e sinopses (ex.: pt-BR, en-US, es-ES)
TMDB_LANGUAGE=pt-BR
# Quantas recomendações mostrar na página
NUM_RECOMMENDATIONS=60
# Quantos dos seus filmes favoritos servem de ponto de partida
MAX_SEED_FILMS=40
# Quantos candidatos analisar a fundo
MAX_CANDIDATES=150
# Ignora filmes com menos votos que isso no TMDB (evita títulos obscuros)
MIN_VOTES=150
